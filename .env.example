# ============================================================
# MFD Tools — environment variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ------------------------------------------------------------------
# Database (Supabase PostgreSQL, Mumbai region recommended for India)
# ------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?pgbouncer=true"

# ------------------------------------------------------------------
# Auth.js v5 (NextAuth)
# Generate AUTH_SECRET with: openssl rand -base64 32
# ------------------------------------------------------------------
AUTH_SECRET="<generate-with-openssl-rand-base64-32>"

# Google OAuth (optional — leave blank to disable Google sign-in)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ------------------------------------------------------------------
# Supabase Storage (for CAS PDF uploads)
# Both values are on: Supabase dashboard → Settings → API
# ------------------------------------------------------------------
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key-from-supabase-dashboard>"

# ------------------------------------------------------------------
# Redis (BullMQ job queue — Railway Redis or Upstash)
# ------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------
# Railway CAS Parser (external PDF → JSON service)
# The parser receives storagePath + optional password, returns CASParsedData
# ------------------------------------------------------------------
RAILWAY_CAS_PARSER_URL="https://<your-railway-service>.up.railway.app"
RAILWAY_CAS_PARSER_SECRET=""    # Optional bearer token for parser auth

# ------------------------------------------------------------------
# Gemini AI (Google Generative AI)
# Create an API key at: https://aistudio.google.com/app/apikey
# Used for: Portfolio AI explanation, Ask Portfolio chat
# ------------------------------------------------------------------
GEMINI_API_KEY="AIza..."

# ------------------------------------------------------------------
# Razorpay (subscription billing)
# Keys available at: https://dashboard.razorpay.com/app/keys
# ------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="<razorpay-secret>"

# ------------------------------------------------------------------
# Encryption (for CAS PDF passwords stored at rest)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hex characters (32 bytes).
# ------------------------------------------------------------------
APP_ENCRYPTION_KEY="<64-char-hex-string>"

# ------------------------------------------------------------------
# Admin / cron endpoints
# Used to protect POST /api/admin/fund-master/sync
# Generate with: openssl rand -base64 32
# ------------------------------------------------------------------
CRON_SECRET="<generate-with-openssl-rand-base64-32>"
